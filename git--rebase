#!/usr/bin/env python3
import curses
import hashlib
import os
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path

PALETTE = [
    curses.COLOR_RED,
    curses.COLOR_GREEN,
    curses.COLOR_YELLOW,
    curses.COLOR_CYAN,
    curses.COLOR_MAGENTA,
    curses.COLOR_WHITE,
    curses.COLOR_BLUE,
]


def git_output(args):
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, check=True
    ).stdout.strip()


def git_run(args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def is_ancestor(base):
    return git_run(["merge-base", "--is-ancestor", base, "HEAD"]).returncode == 0


def branch_shas():
    current = git_output(["rev-parse", "--abbrev-ref", "HEAD"])
    shas = {}
    for line in git_output([
        "for-each-ref",
        "refs/heads",
        "--format=%(objectname) %(refname:short)",
    ]).splitlines():
        sha, branch = line.split(" ", 1)
        if branch != current:
            shas[branch] = sha
    return shas


def branches_at_shas():
    by_sha = {}
    for branch, sha in branch_shas().items():
        by_sha.setdefault(sha, []).append(branch)
    return by_sha


def snapshot():
    return git_output(["rev-parse", "HEAD"]), branch_shas()


def restore(state):
    head, branches = state
    result = git_run(["reset", "--hard", head])
    if result.returncode != 0:
        return result.stderr
    current = branch_shas()
    for branch, sha in branches.items():
        if branch in current and current[branch] == sha:
            continue
        result = git_run(["update-ref", f"refs/heads/{branch}", sha])
        if result.returncode != 0:
            return result.stderr
    return None


def get_entries(base):
    out = git_output(["log", "--reverse", "--format=%H\x1f%s\x1f%D", f"{base}..HEAD"])
    by_sha = branches_at_shas()
    entries = []
    for line in out.splitlines():
        sha, subject, refs = line.split("\x1f")
        hidden = by_sha.get(sha, [])
        refs = ", ".join(t for t in refs.split(", ") if t and t not in hidden)
        entries.append({"type": "commit", "sha": sha, "subject": subject, "refs": refs})
        for branch in hidden:
            entries.append({"type": "update-ref", "branch": branch})
    return entries


def has_merges(base):
    return bool(git_output(["rev-list", "--merges", f"{base}..HEAD"]))


def rebase_dir():
    return Path(git_output(["rev-parse", "--git-path", "rebase-merge"]))


def rebase_in_progress():
    return rebase_dir().is_dir()


def dirty_worktree():
    lines = git_output(["status", "--porcelain"]).splitlines()
    return any(not line.startswith("??") for line in lines)


def has_conflicts():
    return bool(git_output(["diff", "--name-only", "--diff-filter=U"]))


def stopped_sha():
    return (rebase_dir() / "stopped-sha").read_text().strip()


def run_foreground(stdscr, args, env=None, capture=True):
    curses.def_prog_mode()
    curses.endwin()
    stderr = subprocess.PIPE if capture else None
    result = subprocess.run(args, env=env, stderr=stderr, text=True)
    curses.reset_prog_mode()
    stdscr.refresh()
    return result.returncode, result.stderr


def build_todo(entries, cursor, action):
    todo = [dict(e, cmd="pick") for e in entries]
    if action == "move_up":
        todo[cursor - 1], todo[cursor] = todo[cursor], todo[cursor - 1]
    elif action == "move_down":
        todo[cursor], todo[cursor + 1] = todo[cursor + 1], todo[cursor]
    elif action == "delete":
        del todo[cursor]
    else:
        todo[cursor]["cmd"] = action

    lines = []
    for e in todo:
        if e["type"] == "update-ref":
            lines.append(f"update-ref refs/heads/{e['branch']}")
        else:
            lines.append(f"{e['cmd']} {e['sha']} {e['subject']}")
    return lines


NEW_CURSOR = {"move_up": -1, "move_down": 1, "squash": -1, "fixup": -1}

ACTION_LABELS = [
    ("reword", "r reword"),
    ("edit", "e edit"),
    ("squash", "s squash"),
    ("fixup", "f fixup"),
    ("delete", "d delete"),
    ("move_up", "q move up"),
    ("move_down", "a move down"),
    ("edit", "! edit+shell"),
]

ACTION_KEYS = {
    ord("q"): "move_up",
    ord("a"): "move_down",
    ord("s"): "squash",
    ord("f"): "fixup",
    ord("d"): "delete",
    ord("r"): "reword",
    ord("e"): "edit",
}


def action_allowed(action, entries, cursor):
    if not entries:
        return False
    if (
        action in ("reword", "edit", "squash", "fixup")
        and entries[cursor]["type"] != "commit"
    ):
        return False
    if action in ("move_up", "squash", "fixup") and cursor == 0:
        return False
    if action in ("squash", "fixup") and entries[cursor - 1]["type"] != "commit":
        return False
    if action == "move_down" and cursor == len(entries) - 1:
        return False
    return True


def push_history(history, hist_idx, state, cursor):
    history = history[: hist_idx + 1]
    history.append((state, cursor))
    return history, len(history) - 1


def do_action(stdscr, base, entries, cursor, action, auto_shell=False):
    todo = build_todo(entries, cursor, action)
    with tempfile.NamedTemporaryFile("w", delete=False) as f:
        f.write("\n".join(todo) + "\n")
        todo_path = f.name

    env = os.environ.copy()
    env["GIT_SEQUENCE_EDITOR"] = "cp " + shlex.quote(todo_path)
    returncode, stderr = run_foreground(stdscr, ["git", "rebase", "-i", base], env=env)
    Path(todo_path).unlink()

    if rebase_in_progress():
        if not continue_or_abort(stdscr, base, action, auto_shell):
            return entries, cursor, False
    elif returncode != 0:
        show_error(stdscr, stderr)
        return entries, cursor, False

    new_entries = get_entries(base)
    if action == "edit":
        offset = len(new_entries) - len(entries)
    else:
        offset = NEW_CURSOR.get(action, 0)
    new_cursor = max(0, min(cursor + offset, len(new_entries) - 1))
    return new_entries, new_cursor, True


def rebase_done():
    done = rebase_dir() / "done"
    return done.read_text() if done.exists() else None


def rebase_step(stdscr, arg):
    before = rebase_done()
    returncode, stderr = run_foreground(stdscr, ["git", "rebase", arg])
    # stopping at the next conflict also exits non-zero, only report when stuck
    if returncode != 0 and rebase_done() == before:
        show_error(stdscr, stderr)
    return returncode == 0


def continue_or_abort(stdscr, base, action=None, auto_shell=False):
    offset = 0
    last_sha = None

    if auto_shell and rebase_in_progress() and not has_conflicts():
        run_foreground(stdscr, [os.environ.get("SHELL", "/bin/sh")], capture=False)
        rebase_step(stdscr, "--continue")

    while rebase_in_progress():
        diff = []
        if has_conflicts():
            sha = stopped_sha()
            if sha != last_sha:
                offset = 0
                last_sha = sha
            stopped = git_output(["log", "-1", "--format=%s", sha])
            onto = git_output(["log", "-1", "--format=%s", "HEAD"])
            header = f"conflict applying '{stopped}' on top of '{onto}'"
            diff = git_output(["show", sha]).splitlines()
        elif action == "edit":
            last_sha = None
            head_subject = git_output(["log", "-1", "--format=%s", "HEAD"])
            header = f"paused to edit '{head_subject}'"
        else:
            last_sha = None
            header = (
                "rebase paused, not a conflict — likely an empty commit, inspect with !"
            )

        visible = draw_pause(stdscr, header, diff, offset)
        offset = max(0, min(offset, max(0, len(diff) - visible)))

        key = stdscr.getch()
        if key == 27:
            if rebase_step(stdscr, "--abort"):
                return False
        elif key == ord("c"):
            rebase_step(stdscr, "--continue")
        elif key == ord("s"):
            rebase_step(stdscr, "--skip")
        elif key == curses.KEY_UP:
            offset = max(0, offset - 1)
        elif key == curses.KEY_DOWN:
            offset = min(max(0, len(diff) - visible), offset + 1)
        elif key == ord("!"):
            run_foreground(stdscr, [os.environ.get("SHELL", "/bin/sh")], capture=False)
    return True


def show_error(stdscr, stderr):
    stdscr.clear()
    w = stdscr.getmaxyx()[1]
    stdscr.addnstr(0, 0, "git rebase failed:", w - 1)
    lines = stderr.strip().splitlines() or ["(no output)"]
    for i, line in enumerate(lines[:10]):
        stdscr.addnstr(2 + i, 0, line, w - 1)
    stdscr.addnstr(3 + len(lines[:10]), 0, "press any key to continue", w - 1)
    stdscr.refresh()
    stdscr.getch()


def draw_pause(stdscr, header, diff, offset):
    stdscr.clear()
    h, w = stdscr.getmaxyx()
    stdscr.addnstr(0, 0, header, w - 1, curses.A_BOLD)
    visible = h - 5
    for i, line in enumerate(diff[offset : offset + visible]):
        stdscr.addnstr(2 + i, 0, line, w - 1)
    footer = (
        "  c = continue    s = skip    Esc = abort    ! = shell    ↑/↓ scroll"
        if diff
        else "  c = continue    s = skip    Esc = abort    ! = shell"
    )
    stdscr.addnstr(
        h - 2, 0, "resolve here or in another terminal, then:", w - 1, curses.A_DIM
    )
    stdscr.addnstr(h - 1, 0, footer, w - 1, curses.A_DIM)
    stdscr.refresh()
    return visible


def commit_color(subject, salt):
    if not curses.has_colors():
        return 0
    digest = hashlib.md5(f"{salt}{subject}".encode()).digest()[0]
    return digest % len(PALETTE) + 1


def find_salt(entries):
    if not curses.has_colors():
        return 0
    subjects = [e["subject"] for e in entries if e["type"] == "commit"]
    if not subjects:
        return 0
    limit = (len(subjects) - 1) // len(PALETTE) + 1
    for salt in range(500):
        counts = {}
        for subject in subjects:
            color = commit_color(subject, salt)
            counts[color] = counts.get(color, 0) + 1
        if max(counts.values()) <= limit:
            return salt
    return salt


def commit_attr(subject, is_cursor, salt):
    attr = curses.color_pair(commit_color(subject, salt))
    return (attr | curses.A_REVERSE) if is_cursor else attr


def draw(stdscr, entries, cursor, salt):
    stdscr.clear()
    h, w = stdscr.getmaxyx()
    for i, e in enumerate(entries):
        marker = ">" if i == cursor else " "
        if e["type"] == "update-ref":
            line = f"{marker} update-ref {e['branch']}"
            attr = curses.A_REVERSE if i == cursor else curses.A_DIM
        else:
            refs = f" ({e['refs']})" if e["refs"] else ""
            line = f"{marker} {e['sha'][:7]} {e['subject']}{refs}"
            attr = commit_attr(e["subject"], i == cursor, salt)
        stdscr.addnstr(i, 0, line, w - 1, attr)
    available = [
        label
        for action, label in ACTION_LABELS
        if action_allowed(action, entries, cursor)
    ]
    legend = "  ".join([*available, "^Z undo", "^Y redo", "Esc quit"])
    stdscr.addnstr(h - 1, 0, legend, w - 1, curses.A_DIM)
    stdscr.refresh()


def main(stdscr, base):
    curses.curs_set(0)
    curses.raw()
    stdscr.keypad(True)

    if curses.has_colors():
        curses.start_color()
        for i, color in enumerate(PALETTE, start=1):
            curses.init_pair(i, color, curses.COLOR_BLACK)

    entries = get_entries(base)
    cursor = len(entries) - 1 if entries else 0
    salt = find_salt(entries)
    history = [(snapshot(), cursor)]
    hist_idx = 0

    while True:
        draw(stdscr, entries, cursor, salt)
        key = stdscr.getch()
        if key == 27:
            return
        elif key == curses.KEY_UP and cursor > 0:
            cursor -= 1
            history, hist_idx = push_history(
                history, hist_idx, history[hist_idx][0], cursor
            )
        elif key == curses.KEY_DOWN and cursor < len(entries) - 1:
            cursor += 1
            history, hist_idx = push_history(
                history, hist_idx, history[hist_idx][0], cursor
            )
        elif key == 26 and hist_idx > 0:  # Ctrl-Z
            state, cur = history[hist_idx - 1]
            error = restore(state)
            if error is not None:
                show_error(stdscr, error)
            else:
                hist_idx -= 1
                entries, cursor = get_entries(base), cur
        elif key == 25 and hist_idx < len(history) - 1:  # Ctrl-Y
            state, cur = history[hist_idx + 1]
            error = restore(state)
            if error is not None:
                show_error(stdscr, error)
            else:
                hist_idx += 1
                entries, cursor = get_entries(base), cur
        elif key == ord("!") and action_allowed("edit", entries, cursor):
            entries, cursor, ok = do_action(
                stdscr, base, entries, cursor, "edit", auto_shell=True
            )
            if ok:
                history, hist_idx = push_history(history, hist_idx, snapshot(), cursor)
        elif key in ACTION_KEYS and action_allowed(ACTION_KEYS[key], entries, cursor):
            entries, cursor, ok = do_action(
                stdscr, base, entries, cursor, ACTION_KEYS[key]
            )
            if ok:
                history, hist_idx = push_history(history, hist_idx, snapshot(), cursor)


def run():
    if len(sys.argv) != 2:
        sys.exit("usage: git--rebase <commit>")
    if rebase_in_progress():
        sys.exit("a rebase is already in progress — resolve it with plain git first")
    if dirty_worktree():
        sys.exit("working tree has uncommitted changes — commit or stash them first")
    if not is_ancestor(sys.argv[1]):
        sys.exit(f"{sys.argv[1]} is not an ancestor of HEAD")
    if has_merges(sys.argv[1]):
        sys.exit(f"{sys.argv[1]}..HEAD contains merge commits — not supported")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(main, sys.argv[1])


if __name__ == "__main__":
    run()
