#!/usr/bin/env python3
import curses
import os
import shlex
import subprocess
import sys
import tempfile


def git_output(args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()


def git_run(args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def get_commits(base):
    out = git_output(["log", "--reverse", "--format=%H\x1f%s\x1f%D", f"{base}..HEAD"])
    commits = []
    for line in out.splitlines():
        sha, subject, refs = line.split("\x1f")
        commits.append({"sha": sha, "subject": subject, "refs": refs})
    return commits


def rebase_dir():
    return git_output(["rev-parse", "--git-path", "rebase-merge"])


def rebase_in_progress():
    return os.path.isdir(rebase_dir())


def dirty_worktree():
    lines = git_output(["status", "--porcelain"]).splitlines()
    return any(not line.startswith("??") for line in lines)


def has_conflicts():
    return bool(git_output(["diff", "--name-only", "--diff-filter=U"]))


def stopped_subjects():
    stopped_sha = open(os.path.join(rebase_dir(), "stopped-sha")).read().strip()
    stopped = git_output(["log", "-1", "--format=%s", stopped_sha])
    onto = git_output(["log", "-1", "--format=%s", "HEAD"])
    return stopped, onto


def run_foreground(stdscr, args, env=None):
    curses.def_prog_mode()
    curses.endwin()
    result = subprocess.run(args, env=env, stderr=subprocess.PIPE, text=True)
    curses.reset_prog_mode()
    stdscr.refresh()
    return result.returncode, result.stderr


def build_todo(commits, cursor, action):
    todo = [[c["sha"], "pick", c["subject"]] for c in commits]
    if action == "move_up":
        todo[cursor - 1], todo[cursor] = todo[cursor], todo[cursor - 1]
    elif action == "move_down":
        todo[cursor], todo[cursor + 1] = todo[cursor + 1], todo[cursor]
    elif action == "delete":
        del todo[cursor]
    else:
        todo[cursor][1] = action
    return [f"{cmd} {sha} {subject}" for sha, cmd, subject in todo]


NEW_CURSOR = {"move_up": -1, "move_down": 1, "squash": -1, "fixup": -1}

ACTION_KEYS = {
    ord("q"): "move_up",
    ord("a"): "move_down",
    ord("s"): "squash",
    ord("f"): "fixup",
    ord("d"): "delete",
    ord("r"): "reword",
    ord("e"): "edit",
}


def action_allowed(action, cursor, n):
    if action in ("move_up", "squash", "fixup"):
        return cursor > 0
    if action == "move_down":
        return cursor < n - 1
    return True


def do_action(stdscr, base, commits, cursor, action):
    todo = build_todo(commits, cursor, action)
    with tempfile.NamedTemporaryFile("w", delete=False) as f:
        f.write("\n".join(todo) + "\n")
        todo_path = f.name

    env = os.environ.copy()
    env["GIT_SEQUENCE_EDITOR"] = "cp " + shlex.quote(todo_path)
    returncode, stderr = run_foreground(stdscr, ["git", "rebase", "-i", base], env=env)
    os.unlink(todo_path)

    if rebase_in_progress():
        if not continue_or_abort(stdscr, base):
            return commits, cursor, False
    elif returncode != 0:
        show_error(stdscr, stderr)
        return commits, cursor, False

    new_commits = get_commits(base)
    new_cursor = cursor + NEW_CURSOR.get(action, 0)
    new_cursor = max(0, min(new_cursor, len(new_commits) - 1))
    return new_commits, new_cursor, True


def continue_or_abort(stdscr, base):
    while rebase_in_progress():
        draw_pause(stdscr)
        key = stdscr.getch()
        if key == 27:
            run_foreground(stdscr, ["git", "rebase", "--abort"])
            return False
        elif key == ord("c"):
            run_foreground(stdscr, ["git", "rebase", "--continue"])
    return True


def show_error(stdscr, stderr):
    stdscr.clear()
    w = stdscr.getmaxyx()[1]
    stdscr.addnstr(0, 0, "git rebase failed:", w - 1)
    lines = stderr.strip().splitlines() or ["(no output)"]
    for i, line in enumerate(lines[:10]):
        stdscr.addnstr(2 + i, 0, line, w - 1)
    stdscr.addnstr(3 + len(lines[:10]), 0, "press any key to continue", w - 1)
    stdscr.refresh()
    stdscr.getch()


def draw_pause(stdscr):
    stdscr.clear()
    if has_conflicts():
        stopped, onto = stopped_subjects()
        stdscr.addstr(0, 0, f"conflict applying '{stopped}' on top of '{onto}'")
    else:
        head_subject = git_output(["log", "-1", "--format=%s", "HEAD"])
        stdscr.addstr(0, 0, f"paused to edit '{head_subject}'")
    stdscr.addstr(2, 0, "resolve in another terminal, then:")
    stdscr.addstr(3, 0, "  c = continue    Esc = abort")
    stdscr.refresh()


def draw(stdscr, commits, cursor):
    stdscr.clear()
    h, w = stdscr.getmaxyx()
    for i, c in enumerate(commits):
        marker = ">" if i == cursor else " "
        refs = f" ({c['refs']})" if c["refs"] else ""
        line = f"{marker} {c['sha'][:7]} {c['subject']}{refs}"
        attr = curses.A_REVERSE if i == cursor else curses.A_NORMAL
        stdscr.addnstr(i, 0, line, w - 1, attr)
    legend = "r reword  e edit  s squash  f fixup  d delete  q/a move  ^Z undo  ^Y redo  Esc quit"
    stdscr.addnstr(h - 1, 0, legend, w - 1, curses.A_DIM)
    stdscr.refresh()


def main(stdscr, base):
    curses.curs_set(0)
    curses.raw()
    stdscr.keypad(True)

    if rebase_in_progress():
        continue_or_abort(stdscr, base)

    commits = get_commits(base)
    cursor = len(commits) - 1 if commits else 0
    history = [(git_output(["rev-parse", "HEAD"]), cursor)]
    hist_idx = 0

    while True:
        draw(stdscr, commits, cursor)
        if not commits:
            if stdscr.getch() == 27:
                return
            continue

        key = stdscr.getch()
        if key == 27:
            return
        elif key == curses.KEY_UP:
            cursor = max(0, cursor - 1)
        elif key == curses.KEY_DOWN:
            cursor = min(len(commits) - 1, cursor + 1)
        elif key == 26 and hist_idx > 0:  # Ctrl-Z
            sha, cur = history[hist_idx - 1]
            result = git_run(["reset", "--hard", sha])
            if result.returncode != 0:
                show_error(stdscr, result.stderr)
            else:
                hist_idx -= 1
                commits, cursor = get_commits(base), cur
        elif key == 25 and hist_idx < len(history) - 1:  # Ctrl-Y
            sha, cur = history[hist_idx + 1]
            result = git_run(["reset", "--hard", sha])
            if result.returncode != 0:
                show_error(stdscr, result.stderr)
            else:
                hist_idx += 1
                commits, cursor = get_commits(base), cur
        elif key in ACTION_KEYS and action_allowed(ACTION_KEYS[key], cursor, len(commits)):
            commits, cursor, ok = do_action(stdscr, base, commits, cursor, ACTION_KEYS[key])
            if ok:
                history = history[: hist_idx + 1]
                history.append((git_output(["rev-parse", "HEAD"]), cursor))
                hist_idx = len(history) - 1


def run():
    if len(sys.argv) != 2:
        sys.exit("usage: git--rebase <commit>")
    if dirty_worktree():
        sys.exit("working tree has uncommitted changes — commit or stash them first")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(main, sys.argv[1])


if __name__ == "__main__":
    run()
